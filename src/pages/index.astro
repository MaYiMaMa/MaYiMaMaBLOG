---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-copy">
			<p class="hero-brand">{SITE_TITLE}</p>
			<h1 class="hero-lead">把日常慢慢写成文字</h1>
			<p class="hero-support">
				这是一个最小可用的个人博客：写 Markdown，看文章，对外分享。
			</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href={withBase('blog/')}>阅读文章</a>
				<a class="btn btn-ghost" href={withBase('about/')}>关于我</a>
			</div>
		</div>
		<div class="hero-visual" aria-hidden="true"></div>
	</section>

	<section class="section">
		<div class="section-head">
			<h2>最近更新</h2>
			<a href={withBase('blog/')}>查看全部</a>
		</div>
		{latest.length > 0 ? <PostList posts={latest} /> : <p>还没有文章，去 `src/content/blog` 写一篇吧。</p>}
	</section>
</BaseLayout>
