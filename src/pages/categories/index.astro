---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryDescription } from '../../data/categories';
import {
	buildCategorySummaries,
	filterPostsByCategory,
	getPublishedPosts,
} from '../../utils/categories';
import { withBase } from '../../utils/paths';

const allPosts = await getCollection('blog');
const posts = getPublishedPosts(allPosts);
const categories = buildCategorySummaries(allPosts);

function formatDate(date: Date) {
	return date.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}
---

<BaseLayout title="分类" description="按技术方向浏览蚂蚁码码博客文章">
	<header class="page-hero">
		<h1>分类</h1>
		<p>预设技术分类会全部展示；点击分类名可进入该分类，下方也可直接打开文章。</p>
	</header>

	<section class="section category-directory">
		{
			categories.map((category, index) => {
				const categoryPosts = filterPostsByCategory(posts, category.name);
				return (
					<section
						class="category-block"
						style={`animation-delay: ${index * 40}ms`}
						aria-labelledby={`cat-${category.slug}`}
					>
						<header class="category-block-head">
							<div>
								<h2 id={`cat-${category.slug}`}>
									<a href={withBase(`categories/${category.slug}/`)}>{category.name}</a>
								</h2>
								<p>{getCategoryDescription(category.name)}</p>
							</div>
							<span class="category-card-count">{category.count} 篇</span>
						</header>

						{categoryPosts.length === 0 ? (
							<p class="empty-hint">暂无文章。写新文时把 frontmatter 的 category 设为「{category.name}」即可出现在这里。</p>
						) : (
							<ul class="category-post-links">
								{categoryPosts.map((post) => (
									<li>
										<a href={withBase(`blog/${post.id}/`)}>
											<span class="category-post-title">{post.data.title}</span>
											<time datetime={post.data.pubDate.toISOString()}>
												{formatDate(post.data.pubDate)}
											</time>
										</a>
									</li>
								))}
							</ul>
						)}
					</section>
				);
			})
		}
	</section>
</BaseLayout>
