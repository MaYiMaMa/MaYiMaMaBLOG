---
import type { SearchEntry } from '../utils/search';

interface Props {
	entries: SearchEntry[];
	initialQuery?: string;
	autofocus?: boolean;
}

const { entries, initialQuery = '', autofocus = true } = Astro.props;
---

<section class="search-panel" data-search-panel>
	<form class="search-form" role="search" data-search-form>
		<label class="visually-hidden" for="site-search-input">搜索文章</label>
		<input
			id="site-search-input"
			class="search-input"
			type="search"
			name="q"
			placeholder="搜索标题、分类、标签或正文…"
			value={initialQuery}
			autocomplete="off"
			enterkeyhint="search"
			autofocus={autofocus}
			data-search-input
		/>
		<button class="btn btn-primary search-submit" type="submit">搜索</button>
	</form>

	<p class="search-status" data-search-status aria-live="polite"></p>
	<ul class="post-list search-results" data-search-results></ul>
</section>

<script id="search-index-data" type="application/json" set:html={JSON.stringify(entries)} />

<script>
	type SearchEntry = {
		id: string;
		url: string;
		title: string;
		description: string;
		category: string;
		tags: string[];
		haystack: string;
		pubDate: string;
	};

	const dataEl = document.getElementById('search-index-data');
	const panel = document.querySelector('[data-search-panel]');
	if (!dataEl || !panel) {
		// no-op
	} else {
		const entries = JSON.parse(dataEl.textContent || '[]') as SearchEntry[];
		const form = panel.querySelector('[data-search-form]') as HTMLFormElement | null;
		const input = panel.querySelector('[data-search-input]') as HTMLInputElement | null;
		const status = panel.querySelector('[data-search-status]') as HTMLElement | null;
		const results = panel.querySelector('[data-search-results]') as HTMLElement | null;

		function formatDate(iso: string) {
			return new Date(iso).toLocaleDateString('zh-CN', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			});
		}

		function matchEntries(query: string) {
			const terms = query
				.trim()
				.toLowerCase()
				.split(/\s+/)
				.filter(Boolean);
			if (terms.length === 0) return [] as SearchEntry[];
			return entries.filter((entry) => terms.every((term) => entry.haystack.includes(term)));
		}

		function escapeHtml(value: string) {
			return value
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;');
		}

		function render(query: string) {
			if (!status || !results || !input) return;

			const q = query.trim();
			const url = new URL(window.location.href);
			if (q) url.searchParams.set('q', q);
			else url.searchParams.delete('q');
			window.history.replaceState({}, '', url);

			if (!q) {
				status.textContent = `共索引 ${entries.length} 篇文章，输入关键字开始搜索。`;
				results.innerHTML = '';
				return;
			}

			const matched = matchEntries(q);
			status.textContent =
				matched.length === 0
					? `未找到与「${q}」相关的文章。`
					: `找到 ${matched.length} 篇与「${q}」相关的文章。`;

			results.innerHTML = matched
				.map(
					(post, index) => `
						<li class="post-item" style="animation-delay: ${index * 40}ms">
							<div class="post-item-meta">
								<time datetime="${escapeHtml(post.pubDate)}">${escapeHtml(formatDate(post.pubDate))}</time>
								<span class="post-category-link">${escapeHtml(post.category)}</span>
							</div>
							<a class="post-item-main" href="${escapeHtml(post.url)}">
								<h3>${escapeHtml(post.title)}</h3>
								<p>${escapeHtml(post.description)}</p>
							</a>
						</li>
					`,
				)
				.join('');
		}

		let timer = 0;
		input?.addEventListener('input', () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => render(input.value), 160);
		});

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			if (input) render(input.value);
		});

		render(input?.value || '');
	}
</script>
