---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const links = [
	{ href: withBase(), label: '首页', match: 'home' as const },
	{ href: withBase('blog/'), label: '文章', match: 'blog' as const },
	{ href: withBase('categories/'), label: '分类', match: 'categories' as const },
	{ href: withBase('about/'), label: '关于', match: 'about' as const },
];

function isCurrent(match: (typeof links)[number]['match']) {
	const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
	if (match === 'home') {
		return normalized === base || normalized === '/';
	}
	if (match === 'blog') {
		return (
			normalized.includes('/blog/') &&
			!normalized.includes('/categories/')
		);
	}
	return normalized.includes(`/${match}/`);
}
---

<header class="site-header">
	<a class="brand" href={withBase()}>
		{SITE_TITLE}
		<span>MaYiMaMa</span>
	</a>
	<nav class="nav" aria-label="主导航">
		{
			links.map((link) => (
				<a href={link.href} aria-current={isCurrent(link.match) ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>
</header>
